{
  "name": "pickixo-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.mjs --dev",
    "start": "next start -p 3010",
    "start:tls": "node server.mjs",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cert": "bash ../../scripts/make-dev-cert.sh",
    "sync:ort": "node scripts/sync-ort-assets.mjs",
    "prebuild": "node scripts/sync-ort-assets.mjs && node scripts/clear-data-cache.mjs",
    "predev": "node scripts/sync-ort-assets.mjs"
  },
  "dependencies": {
    "next": "14.2.21",
    "onnxruntime-web": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.21",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
