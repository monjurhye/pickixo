# =============================================================================
# Pickixo — environment template
#
# Copy to .env and fill in. .env is gitignored and must never be committed,
# and must never be included in a Google Drive backup (§94).
#
# Every AI provider key is optional. A provider with no key is treated as not
# configured and skipped by the router — it is never faked, and its absence
# never stops the application starting (§38).
# =============================================================================

# --- core --------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_NAME=Pickixo
LOG_LEVEL=info

# Canonical public origin. Used for canonical URLs, sitemap and Open Graph.
SITE_URL=https://pickixo.com
# Where the browser reaches the frontend (used for OAuth redirects back).
APP_BASE_URL=https://localhost:3010
# 8010/3010 rather than 8000/3000 because the old Hye application still holds
# those ports on this machine. Move them back once it is decommissioned.
BACKEND_PORT=8010
FRONTEND_PORT=3010
CORS_ALLOWED_ORIGINS=https://localhost:3010

# --- database ----------------------------------------------------------------
# Local PostgreSQL. The application role is NOT a superuser and cannot alter
# the schema; migrations are applied as the owner.
DATABASE_URL=postgresql://pickixo_app:CHANGEME@127.0.0.1:5432/pickixo

# --- auth --------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating JWT_SECRET invalidates every access token immediately. Refresh
# tokens survive, because those are database rows.
JWT_SECRET=
# Salts the hash that identifies a signed-out visitor for rate limiting, so no
# raw IP address is ever stored.
GUEST_KEY_SALT=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_COOKIE_NAME=pickixo_session
# MUST be true in production; the API refuses to start otherwise, because a
# session cookie over plain HTTP is a session anyone on the path can read.
#
# Left false in local development on purpose. The browser now reaches the site
# over HTTPS, so turning this on works fine there — but the API integration
# tests talk plain HTTP to loopback, and a Secure cookie is one the test client
# will refuse to send back. To develop against production-like cookies:
#   SESSION_COOKIE_SECURE=true
#   PICKIXO_API=https://localhost:3010/api  python -m tests.test_api_flows
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=

PASSWORD_MIN_LENGTH=10

# --- google sign-in ----------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Add the redirect URI below to that client's
# "Authorised redirect URIs" list or Google will reject the callback.
#
# Leave empty to disable Google sign-in: the sign-in page then shows no Google
# button rather than one that fails.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pickixo.com/api/auth/google/callback

# --- pickbot -----------------------------------------------------------------
# The snapshot Pickbot writes after every pass, and the wrapper script the
# admin-only Run button invokes. Leave either empty to disable that half: no
# path means no dashboard, no command means no running it from the browser.
PICKBOT_SNAPSHOT_PATH=C:\Users\Administrator\Desktop\Trading App\scanner\state\rot-export.json
PICKBOT_COMMAND=C:\Users\Administrator\Desktop\Trading App\scanner\run-pickbot.cmd

# --- AI providers ------------------------------------------------------------
# Order the router tries them in. A provider that is disabled, unkeyed or in
# cooldown is skipped without a network call.
TEXT_PROVIDER_PRIORITY=groq,anthropic,cerebras,openrouter,mistral,nvidia_nim,gemini,pollinations_text,ollama
IMAGE_PROVIDER_PRIORITY=cloudflare_image,pollinations_image

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ENABLED=false

# Paid fallback, second in the priority list so it only answers when Groq is
# rate-limited, out of daily quota or down. Claude Haiku 4.5 is the cheapest
# current Claude model ($1 / $5 per million tokens in / out, checked 2026-09).
# Key from console.anthropic.com > API Keys. A credential: .env only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_ENABLED=false

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_ENABLED=false

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_ENABLED=false

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_ENABLED=false

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_ENABLED=false

# Ships disabled on purpose. Google's free Gemini tier trains on submitted
# content and permits human review. Read docs/PROVIDER_TERMS.md before
# enabling it for public users — that is a privacy decision, not a config flag.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=false

POLLINATIONS_API_KEY=
POLLINATIONS_TEXT_MODEL=openai
POLLINATIONS_TEXT_ENABLED=false
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_IMAGE_ENABLED=false

# Local model served by Ollama on this machine. No credential, nothing leaves
# the server, but CPU-only inference is slow — hence the long timeout.
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_ENABLED=false
OLLAMA_TIMEOUT_SECONDS=600

# Cloudflare Workers AI — the image provider with a recurring free allowance.
# The token needs Workers AI read and edit, nothing else.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_ENABLED=false

# --- tools: youtube transcripts ----------------------------------------------
# transcriptapi.com. One credit per SUCCESSFUL fetch, so the application checks
# its own cache first and only spends a user's daily allowance on a real call.
# Server-side only: this must never reach the browser.
TRANSCRIPT_API_KEY=

LIMIT_TRANSCRIPT_PER_DAY=25
LIMIT_GUEST_TRANSCRIPT_PER_DAY=5

# --- storage -----------------------------------------------------------------
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=25
# Signs media URLs so an <img> works without an Authorization header.
FILE_URL_SECRET=
FILE_URL_TTL_SECONDS=21600

# --- daily limits ------------------------------------------------------------
# Overridable at runtime from Admin > Settings without a redeploy.
LIMIT_TEXT_PER_DAY=50
LIMIT_IMAGE_PER_DAY=20
LIMIT_GUEST_TEXT_PER_DAY=5
LIMIT_GUEST_IMAGE_PER_DAY=2

# --- search engines ----------------------------------------------------------
# Verification tokens are per-deployment and are never committed. Absent is
# correct until the owner pastes theirs in; see docs/SEO.md for the exact steps.
# Paste only the content value, not the whole <meta> tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Proves host control to IndexNow. nginx serves it at https://<site>/<key>.txt
# from C:\Pickixo\wellknown, so the key is never a file in the repository.
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
INDEXNOW_KEY=

# --- frontend (NEXT_PUBLIC_* reaches the browser — never put a secret here) ---
NEXT_PUBLIC_SITE_URL=https://pickixo.com
# The browser always calls same-origin /api/*, which the web tier proxies to
# the API. Nothing browser-side needs the API host.
NEXT_PUBLIC_API_URL=/api

# --- meta / facebook -------------------------------------------------------
# From your Meta app at developers.facebook.com. The agent cannot reach a Page
# without all four. See docs/FACEBOOK_SETUP.md.
#
# META_APP_SECRET is a credential: it must never appear in frontend code, in a
# log, in an AI prompt, or in git.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://pickixo.com/api/facebook/callback
META_GRAPH_VERSION=v25.0
# Facebook Login for Business configuration ID (Facebook Login for Business >
# Configurations). When set, the login dialog uses it instead of a scope list,
# as Meta recommends. Not a secret. Empty = the classic scope list.
META_LOGIN_CONFIG_ID=
# Numeric ID of the one Page this deployment manages. Required when the
# connecting account runs several Pages; without it the connection is refused
# rather than guessing. Not a secret.
FACEBOOK_PAGE_ID=

# Encrypts stored Page access tokens at rest (AES-256-GCM). 32 bytes, base64.
# Generate one per deployment — see docs/FACEBOOK_SETUP.md. Rotating this makes
# every stored token unreadable, which means reconnecting the Page.
FACEBOOK_TOKEN_KEY=

# --- facebook agent --------------------------------------------------------
# The worker refuses to start unless this is true, rather than running and
# silently never acting.
FACEBOOK_AGENT_ENABLED=false
# How often the supervisor wakes the agent. This is only a wake-up; the agent
# decides whether anything should happen.
FACEBOOK_AGENT_TICK_SECONDS=300
# Ceilings the dashboard cannot raise past.
FACEBOOK_AGENT_MAX_FEED_POSTS_PER_DAY=6
FACEBOOK_AGENT_MAX_STORIES_PER_DAY=10
FACEBOOK_AGENT_MAX_REPLIES_PER_HOUR=30
FACEBOOK_AGENT_MAX_REELS_PER_DAY=4

# --- reels -------------------------------------------------------------------
# Rendered on this server: AI stills, Piper narration, captions, ffmpeg. Free.
# See docs/FACEBOOK_SETUP.md, "7b. Reels", for the voice download.
REEL_VOICE_MODEL=./storage/voices/en_US-ryan-high.onnx
REEL_FFMPEG=ffmpeg
# The optional paid opening clip (Wan 2.6 Flash via fal.ai, ~$0.13 per reel at
# silent 720p). Needs both the key and the flag; without them reels open on a
# moving still. FAL_KEY is a credential: .env only.
REEL_HOOK_ENABLED=false
FAL_KEY=
REEL_HOOK_MODEL=wan/v2.6/image-to-video/flash
REEL_HOOK_RESOLUTION=720p
REEL_HOOK_SECONDS=5
REEL_HOOK_TIMEOUT_SECONDS=480

# --- backup ----------------------------------------------------------------
# Encrypts the weekly Google Drive archive (7-Zip, AES-256, encrypted headers).
# Generated once by scripts/backup/Install-BackupTask.ps1 and stored nowhere
# else — copy it into a password manager, because losing it makes every archive
# already in Drive permanently unopenable. See docs/BACKUP.md.
BACKUP_PASSPHRASE=
